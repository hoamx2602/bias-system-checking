# Copy this file to .env and fill in your values.

# Hugging Face authentication token (required)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_token_here

# Cache directory for HF models (relative to working directory)
HF_CACHE_DIR=@.hf_cache

# Windows: disable symlinks/hardlinks to avoid permission errors
HF_HUB_DISABLE_SYMLINKS=1
HF_HUB_DISABLE_HARDLINKS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Flask debug mode (set to True only during local development)
FLASK_DEBUG=False

# Synthetic data generation providers. Leave keys unset when using plan/dry-run commands.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Pin exact model IDs/snapshots for reproducible production runs.
OPENAI_GENERATION_MODEL=gpt-4o-mini-2024-07-18
OPENAI_JUDGE_MODEL=gpt-4.1-2025-04-14
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-pro
ANTHROPIC_GENERATION_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_JUDGE_MODEL=claude-sonnet-4-6
