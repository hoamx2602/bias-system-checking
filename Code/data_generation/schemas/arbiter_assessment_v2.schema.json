{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arbiter_assessment_v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "bias_assessment", "severity_level", "evidence_spans",
    "evidence_strength", "objective_criteria_consistent", "decision_affected",
    "legitimate_justification", "alternative_explanation", "fact_preservation",
    "realism_score", "confidence", "reason_codes"
  ],
  "properties": {
    "record_id": {"type": "string"},
    "bias_assessment": {"enum": ["present", "absent", "insufficient_evidence"]},
    "severity_level": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "evidence_spans": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
    "evidence_strength": {"enum": ["none", "weak", "moderate", "strong"]},
    "objective_criteria_consistent": {"type": "boolean"},
    "decision_affected": {"enum": ["yes", "no", "unclear"]},
    "legitimate_justification": {"enum": ["supported", "unsupported", "not_applicable", "unclear"]},
    "alternative_explanation": {"type": ["string", "null"]},
    "fact_preservation": {"type": "boolean"},
    "realism_score": {"type": "integer", "minimum": 1, "maximum": 5},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
