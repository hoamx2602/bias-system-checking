{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated_family_v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["family_id", "generation_status", "failure_reason", "variants"],
  "properties": {
    "family_id": {"type": "string", "minLength": 4},
    "generation_status": {"enum": ["complete", "invalid_control_card"]},
    "failure_reason": {"type": ["string", "null"]},
    "variants": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id", "severity_level", "text", "decision_outcome",
          "criteria_applied", "criteria_distorted_or_ignored",
          "mechanism_manifestation", "bias_affects_decision",
          "invariant_fact_checks", "evidence_candidates"
        ],
        "properties": {
          "variant_id": {"enum": ["v0", "v1", "v2", "v3", "v4", "v5"]},
          "severity_level": {"type": "integer", "minimum": 0, "maximum": 5},
          "text": {"type": "string", "minLength": 80},
          "decision_outcome": {"type": "string", "minLength": 8},
          "criteria_applied": {
            "type": "array", "uniqueItems": true, "items": {"type": "string"}
          },
          "criteria_distorted_or_ignored": {
            "type": "array", "uniqueItems": true, "items": {"type": "string"}
          },
          "mechanism_manifestation": {
            "enum": [
              "none", "corrected_cue", "unequal_process", "material_contribution",
              "decision_override", "explicit_exclusion_or_manipulation"
            ]
          },
          "bias_affects_decision": {"type": "boolean"},
          "invariant_fact_checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fact", "preserved"],
              "properties": {
                "fact": {"type": "string"},
                "preserved": {"type": "boolean"}
              }
            }
          },
          "evidence_candidates": {
            "type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 3}
          }
        }
      }
    }
  }
}
