{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judge_result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "bias_present", "severity_level", "bias_mechanisms",
    "evidence_spans", "objective_criteria_consistent", "decision_affected",
    "realism_score", "confidence", "reason_codes"
  ],
  "properties": {
    "record_id": {"type": "string"},
    "bias_present": {"type": "boolean"},
    "severity_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "bias_mechanisms": {"type": "array", "items": {"type": "string"}},
    "evidence_spans": {"type": "array", "items": {"type": "string"}},
    "objective_criteria_consistent": {"type": "boolean"},
    "decision_affected": {"type": "boolean"},
    "realism_score": {"type": "integer", "minimum": 1, "maximum": 5},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason_codes": {"type": "array", "items": {"type": "string"}}
  }
}
