{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judge_family_v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "family_id", "ranked_opaque_ids", "tied_groups", "pairwise_findings",
    "invariant_preserved", "endpoint_separation", "verdict", "confidence", "reason_codes"
  ],
  "properties": {
    "family_id": {"type": "string"},
    "ranked_opaque_ids": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "tied_groups": {"type": "array", "items": {"type": "array", "minItems": 2, "items": {"type": "string"}}},
    "pairwise_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lower_id", "higher_id", "increase_supported", "basis"],
        "properties": {
          "lower_id": {"type": "string"},
          "higher_id": {"type": "string"},
          "increase_supported": {"type": "boolean"},
          "basis": {"enum": ["framing", "unequal_process", "criteria_distortion", "decision_causality", "no_reliable_difference"]}
        }
      }
    },
    "invariant_preserved": {"type": "boolean"},
    "endpoint_separation": {"enum": ["clear", "weak", "absent"]},
    "verdict": {"enum": ["accept", "repair", "human_review", "reject"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["MONOTONIC", "SEVERITY_INVERSION", "ADJACENT_COLLAPSE", "FACT_DRIFT", "WEAK_NEUTRAL_ENDPOINT", "WEAK_EXTREME_ENDPOINT", "UNREALISTIC_FAMILY", "INSUFFICIENT_EVIDENCE"]}
    }
  }
}
