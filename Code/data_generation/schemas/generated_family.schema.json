{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated_family.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["family_id", "variants"],
  "properties": {
    "family_id": {"type": "string"},
    "variants": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "severity_level", "text", "evidence_candidates"],
        "properties": {
          "variant_id": {"enum": ["v0", "v1", "v2", "v3", "v4", "v5"]},
          "severity_level": {"type": "integer", "minimum": 0, "maximum": 5},
          "text": {"type": "string", "minLength": 40},
          "evidence_candidates": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
